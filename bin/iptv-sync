#!/usr/bin/env python3
"""Single-provider IPTV sync for the Omarchy IPTV plugin (stdlib only).

Reads  ~/.config/omarchy-iptv/provider.json  (one provider):

  m3u:    {"type": "m3u", "url": "https://.../playlist.m3u",
           "epg": "https://.../xmltv.xml"}            # epg optional
  xtream: {"type": "xtream", "host": "http://host:8080",
           "username": "user"}                        # password via
           # secret-tool / $IPTV_PASSWORD / "password" key (last resort)

  Optional for both: "user_agent": "..."  (some providers whitelist UAs)

Cache lives in ~/.cache/omarchy-iptv/: channels.json, vod.json,
series.json, series/<id>.json (episodes, fetched on demand, 6h TTL),
epg.db. Only now-2h..now+24h of EPG is kept, so the shell never holds a
week of listings in memory.

NOTE: stream URLs for Xtream embed the password (required by the
protocol). They stay in mode-600 cache files. --dump-* for the shell
omits urls; --play-url looks one up at play time. Error output is
passed through redact() so a password can never reach the shell log.
"""

import argparse
import hashlib
import io
import json
import os
import re
import sqlite3
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import zlib
from datetime import datetime, timedelta, timezone
from xml.etree import ElementTree as ET

CONFIG_DIR = os.path.expanduser("~/.config/omarchy-iptv")
CONFIG = os.path.join(CONFIG_DIR, "provider.json")
CACHE = os.path.expanduser("~/.cache/omarchy-iptv")
CHANNELS_JSON = os.path.join(CACHE, "channels.json")
VOD_JSON = os.path.join(CACHE, "vod.json")
SERIES_JSON = os.path.join(CACHE, "series.json")
SERIES_DIR = os.path.join(CACHE, "series")  # one <series_id>.json of episodes per show
EPISODES_TTL = 6 * 3600
EPG_DB = os.path.join(CACHE, "epg.db")
TIMEOUT = 60
DEFAULT_UA = "omarchy-iptv/1.0"
PLUGIN_ID = "io.github.sam-blakeman.iptv"
SECRET_APP = PLUGIN_ID
SECRET_APP_LEGACY = "user.iptv"

# Strings that must never appear in stderr (filled in by sync_xtream).
SECRETS = []


def redact(text):
    text = str(text)
    for s in SECRETS:
        if s:
            text = text.replace(s, "***")
            text = text.replace(urllib.parse.quote(s, safe=""), "***")
    return text


def warn(msg):
    print(redact(msg), file=sys.stderr)


def die(msg, code=1):
    warn(msg)
    sys.exit(code)


# --- config / secrets -------------------------------------------------------

def load_provider():
    try:
        with open(CONFIG) as f:
            return json.load(f)
    except FileNotFoundError:
        return None
    except json.JSONDecodeError as e:
        die(f"bad {CONFIG}: {e}")


def _secret_lookup(app, username):
    try:
        p = subprocess.run(
            ["secret-tool", "lookup", "application", app, "username", username],
            capture_output=True, text=True, timeout=10)
        if p.returncode == 0 and p.stdout.strip():
            return p.stdout.strip()
    except (FileNotFoundError, subprocess.TimeoutExpired):
        pass
    return None


def get_password(prov):
    username = prov.get("username") or ""
    if not username:
        return None
    if os.environ.get("IPTV_PASSWORD"):
        return os.environ["IPTV_PASSWORD"]
    for app in (SECRET_APP, SECRET_APP_LEGACY):
        pw = _secret_lookup(app, username)
        if pw:
            return pw
    if prov.get("password"):
        mode = os.stat(CONFIG).st_mode & 0o777
        if mode & 0o077:
            warn(f"warning: {CONFIG} holds a password but is mode {mode:o}; "
                 "chmod 600 it")
        return prov["password"]
    return None


def store_password(username, password):
    if not username or not password:
        return
    try:
        p = subprocess.run(
            ["secret-tool", "store", "--label", "omarchy-iptv",
             "application", SECRET_APP, "username", username],
            input=password, capture_output=True, text=True, timeout=15)
    except (FileNotFoundError, subprocess.TimeoutExpired) as e:
        die(f"secret-tool store failed: {e}")
    if p.returncode != 0:
        die("secret-tool store failed: " + (p.stderr or p.stdout or "unknown error"))


def write_provider(args):
    t = (args.prov_type or "").strip()
    if t not in ("m3u", "xtream"):
        die("type must be m3u or xtream")
    pw = ""
    if not sys.stdin.isatty():
        pw = sys.stdin.readline().rstrip("\n")
    out = {"type": t}
    ua = (args.user_agent or "").strip()
    if ua:
        out["user_agent"] = ua
    if t == "xtream":
        host = (args.host or "").strip().rstrip("/")
        user = (args.username or "").strip()
        if not host or not user:
            die("xtream needs host and username")
        if not host.startswith(("http://", "https://")):
            host = "http://" + host
        out["host"] = host
        out["username"] = user
        if pw:
            store_password(user, pw)
        elif not get_password(out):
            die("xtream password missing")
    else:
        url = (args.url or "").strip()
        if not url:
            die("m3u needs url")
        out["url"] = url
        epg = (args.epg or "").strip()
        if epg:
            out["epg"] = epg
    os.makedirs(CONFIG_DIR, exist_ok=True)
    tmp = CONFIG + ".tmp"
    with os.fdopen(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
        json.dump(out, f)
        f.write("\n")
    os.replace(tmp, CONFIG)
    os.chmod(CONFIG, 0o600)
    print("wrote provider.json")


# --- http -------------------------------------------------------------------

MIB = 1024 * 1024
CHUNK = 256 * 1024
GZIP_MAGIC = b"\x1f\x8b"

# Hard caps on what a provider may send, so a broken, compromised or hostile
# server (or a gzip bomb) cannot exhaust memory during sync. Per kind:
# (bytes on the wire, bytes after gzip expansion). M3U and Xtream JSON are
# held in memory whole, so their caps are tight. XMLTV is stream-parsed
# into sqlite (see import_xmltv), so its expanded cap bounds work, not
# memory. Documented in README "Limits".
LIMITS = {
    "m3u": (32 * MIB, 128 * MIB),
    "json": (32 * MIB, 128 * MIB),
    "xmltv": (256 * MIB, 2048 * MIB),
}


class ResponseTooLarge(Exception):
    pass


class BoundedReader:
    """File-like view of an HTTP body: counts compressed bytes, inflates
    gzip incrementally, and raises ResponseTooLarge the moment either cap
    is crossed. Never buffers more than about one CHUNK of look-ahead, so
    a caller that streams (ET.iterparse) holds no more than that."""

    def __init__(self, raw, max_compressed, max_expanded, kind="provider"):
        self.raw = raw
        self.max_compressed = max_compressed
        self.max_expanded = max_expanded
        self.kind = kind
        self.n_in = self.n_out = 0
        self._gz = None  # unknown until the first bytes are sniffed
        self._dec = None
        self._buf = b""
        self._eof = False

    def _too_large(self, what, cap):
        raise ResponseTooLarge(
            f"{self.kind} response exceeded the {cap // MIB} MiB {what} limit")

    def _pull(self):
        """Next expanded chunk, or b"" once the body is exhausted. May also
        return b"" before EOF when the inflater wants more input."""
        if self._dec is not None and self._dec.unconsumed_tail:
            out = self._dec.decompress(self._dec.unconsumed_tail, CHUNK)
        else:
            chunk = self.raw.read(CHUNK)
            while self._gz is None and chunk and len(chunk) < 2:
                more = self.raw.read(CHUNK)  # need 2 bytes to sniff gzip
                if not more:
                    break
                chunk += more
            if not chunk:
                self._eof = True
                if self._dec is not None and not self._dec.eof:
                    raise ValueError("truncated gzip response")
                return b""
            self.n_in += len(chunk)
            if self.n_in > self.max_compressed:
                self._too_large("download", self.max_compressed)
            if self._gz is None:
                self._gz = chunk[:2] == GZIP_MAGIC
                if self._gz:
                    self._dec = zlib.decompressobj(16 + zlib.MAX_WBITS)
            out = self._dec.decompress(chunk, CHUNK) if self._gz else chunk
        self.n_out += len(out)
        if self.n_out > self.max_expanded:
            self._too_large("expanded", self.max_expanded)
        return out

    def read(self, n=-1):
        if n is None or n < 0:
            parts = [self._buf]
            self._buf = b""
            while not self._eof:
                parts.append(self._pull())
            return b"".join(parts)
        while len(self._buf) < n and not self._eof:
            self._buf += self._pull()
        out, self._buf = self._buf[:n], self._buf[n:]
        return out


def _open(url, user_agent, kind):
    max_c, max_e = LIMITS[kind]
    req = urllib.request.Request(
        url, headers={"User-Agent": user_agent or DEFAULT_UA,
                      "Accept-Encoding": "gzip"})
    r = urllib.request.urlopen(req, timeout=TIMEOUT)
    length = r.headers.get("Content-Length") or ""
    if length.isdigit() and int(length) > max_c:
        r.close()
        raise ResponseTooLarge(
            f"{kind} response advertises {int(length) // MIB} MiB, over the "
            f"{max_c // MIB} MiB download limit")
    return r, BoundedReader(r, max_c, max_e, kind)


def fetch(url, user_agent=None, kind="m3u"):
    """Whole body as bytes, gzip expanded, within LIMITS[kind]."""
    r, body = _open(url, user_agent, kind)
    with r:
        return body.read()


def fetch_json(url, user_agent=None):
    return json.loads(fetch(url, user_agent, "json").decode("utf-8", "replace"))


def fetch_xmltv(url, user_agent=None):
    """Stream the guide from the socket straight into sqlite; the file is
    never held in memory whole."""
    r, body = _open(url, user_agent, "xmltv")
    with r:
        return import_xmltv(body)


# --- m3u --------------------------------------------------------------------

ATTR_RE = re.compile(r'([\w.-]+)="([^"]*)"')


def split_extinf(line):
    """Return (attrs_text, name) for an #EXTINF line.

    The name starts after the first comma that is outside double quotes,
    so `group-title="UK, News",BBC One` and `#EXTINF:0,Name, With Comma`
    both come out right.
    """
    in_quote = False
    for i, ch in enumerate(line):
        if ch == '"':
            in_quote = not in_quote
        elif ch == "," and not in_quote:
            return line[:i], line[i + 1:].strip()
    return line, ""


def stable_id(url, name, group):
    # Same row => same id across re-syncs regardless of playlist order, so
    # favorites survive; two streams sharing one tvg-id (HD/SD variants) or
    # one URL listed under two groups stay distinct.
    key = f"{url}\n{name}\n{group}".encode("utf-8", "replace")
    return "m3u-" + hashlib.sha1(key).hexdigest()[:12]


def parse_m3u(text):
    channels = []
    current = None
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        if line.upper().startswith("#EXTINF"):
            head, name = split_extinf(line)
            attrs = dict(ATTR_RE.findall(head))
            current = {
                "tvg_id": attrs.get("tvg-id", ""),
                "logo": attrs.get("tvg-logo", ""),
                "group": attrs.get("group-title") or "Ungrouped",
                "name": name or attrs.get("tvg-name") or "Unknown",
            }
        elif line.startswith("#"):
            continue  # #EXTVLCOPT, #KODIPROP, #EXTGRP, ...
        elif current is not None:
            current["url"] = line
            current["id"] = stable_id(line, current["name"], current["group"])
            channels.append(current)
            current = None
    return channels


# --- xmltv ------------------------------------------------------------------

XMLTV_TIME_RE = re.compile(r"(\d{14})(?:\s+([+-])(\d{2})(\d{2}))?")


def parse_xmltv_time(s):
    # "20260907120000 +0200" (offset optional, defaults to UTC)
    m = XMLTV_TIME_RE.match((s or "").strip())
    if not m:
        return None
    dt = datetime.strptime(m.group(1), "%Y%m%d%H%M%S")
    tz = timezone.utc
    if m.group(2):
        minutes = int(m.group(3)) * 60 + int(m.group(4))
        tz = timezone(timedelta(minutes=-minutes if m.group(2) == "-" else minutes))
    return int(dt.replace(tzinfo=tz).timestamp())


def epg_db():
    os.makedirs(CACHE, exist_ok=True)
    db = sqlite3.connect(EPG_DB)
    os.chmod(EPG_DB, 0o600)
    db.execute("""CREATE TABLE IF NOT EXISTS programmes
                  (channel TEXT, start INTEGER, end INTEGER,
                   title TEXT, desc TEXT)""")
    db.execute("CREATE INDEX IF NOT EXISTS idx_prog ON programmes(channel, start, end)")
    db.execute("""CREATE TABLE IF NOT EXISTS channels
                  (id TEXT PRIMARY KEY, name TEXT)""")
    return db


def _text(elem, tag):
    child = elem.find(tag)
    return child.text.strip() if child is not None and child.text else ""


def import_xmltv(source):
    """Stream-parse XMLTV (bytes or a file-like reader) straight into
    sqlite. Nothing proportional to the guide's size stays in memory:
    handled <channel>/<programme> elements are dropped from the tree as
    they complete, rows go to the db in batches, and only now-2h..now+24h
    programmes are kept. Runs in one transaction, so a bad or oversized
    guide leaves the previous EPG intact."""
    if isinstance(source, (bytes, bytearray)):
        source = io.BytesIO(source)
    now = int(time.time())
    keep_from, keep_to = now - 2 * 3600, now + 24 * 3600
    kept = 0
    rows, names, root = [], [], None
    db = epg_db()

    def flush():
        if rows:
            db.executemany("INSERT INTO programmes VALUES (?,?,?,?,?)", rows)
            rows.clear()
        if names:
            db.executemany("INSERT OR REPLACE INTO channels VALUES (?,?)", names)
            names.clear()

    try:
        with db:
            db.execute("DELETE FROM programmes")
            db.execute("DELETE FROM channels")
            for event, el in ET.iterparse(source, events=("start", "end")):
                if event == "start":
                    if root is None:
                        root = el
                    continue
                if el.tag == "channel":
                    cid = el.get("id", "")
                    dn = _text(el, "display-name")
                    if cid and dn:
                        names.append((cid, dn))
                elif el.tag == "programme":
                    start = parse_xmltv_time(el.get("start"))
                    end = parse_xmltv_time(el.get("stop"))
                    if start and end and end >= keep_from and start <= keep_to:
                        rows.append((el.get("channel", ""), start, end,
                                     _text(el, "title"), _text(el, "desc")[:500]))
                        kept += 1
                else:
                    continue  # <title>, <desc>...: wait for the parent to end
                root.clear()  # forget the finished element and its siblings
                if len(rows) + len(names) >= 5000:
                    flush()
            flush()
    finally:
        db.close()
    return kept


def epg_window():
    """All programmes overlapping now..now+6h, keyed by channel."""
    now = int(time.time())
    if not os.path.exists(EPG_DB):  # never create an empty db from a dump
        return now, {}
    try:
        db = sqlite3.connect(f"file:{EPG_DB}?mode=ro", uri=True)
        try:
            rows = db.execute(
                "SELECT channel, start, end, title FROM programmes "
                "WHERE end > ? AND start < ? ORDER BY start",
                (now, now + 6 * 3600)).fetchall()
        finally:
            db.close()
    except sqlite3.Error:
        return now, {}
    by_ch = {}
    for cid, s, e, t in rows:
        by_ch.setdefault(cid, []).append({"start": s, "end": e, "title": t or ""})
    return now, by_ch


def now_next(progs, now):
    cur = nxt = ""
    for p in progs:
        if p["start"] <= now < p["end"]:
            cur = p["title"]
        elif p["start"] > now and not nxt:
            nxt = p["title"]
    return cur, nxt


# --- sync -------------------------------------------------------------------

def sync_m3u(prov):
    ua = prov.get("user_agent")
    channels = parse_m3u(fetch(prov["url"], ua).decode("utf-8", "replace"))
    if not channels:
        die("playlist fetched but no channels parsed; is the url an m3u?")
    save_json(CHANNELS_JSON, channels)
    save_json(VOD_JSON, [])  # m3u has no VOD split in v1
    save_json(SERIES_JSON, [])  # ...nor a series catalog
    kept = 0
    if prov.get("epg"):
        try:
            kept = fetch_xmltv(prov["epg"], ua)
        except Exception as e:
            warn(f"warning: EPG fetch failed ({e}); continuing without EPG")
    return len(channels), 0, 0, kept


def xtream_api(prov):
    """(host, api base url with credentials, quoted user, quoted pw, ua)."""
    host = prov["host"].rstrip("/")
    user = prov["username"]
    pw = get_password(prov)
    if not pw:
        die("xtream password missing: set it in Setup, or secret-tool store "
            f"--label omarchy-iptv application {SECRET_APP} username {user}")
    if pw not in SECRETS:
        SECRETS.append(pw)
    q_user, q_pw = urllib.parse.quote(user, safe=""), urllib.parse.quote(pw, safe="")
    api = f"{host}/player_api.php?username={q_user}&password={q_pw}"
    return host, api, q_user, q_pw, prov.get("user_agent")


def series_rows(series, cats):
    """Shell-facing catalog rows for get_series output. Episodes are not
    fetched here: one get_series_info call per show would turn a sync into
    thousands of requests, so they load on demand (fetch_episodes)."""
    rows = []
    for s in series or []:
        sid = s.get("series_id")
        if sid is None:
            continue
        release = str(s.get("releaseDate") or s.get("release_date") or "")
        rows.append({
            "id": f"xcs-{sid}",
            "series_id": sid,
            "name": s.get("name") or f"series {sid}",
            "logo": s.get("cover") or "",
            "group": cats.get(str(s.get("category_id")), "Ungrouped"),
            "plot": (s.get("plot") or "")[:240],
            "year": release[:4],
            "rating": str(s.get("rating") or ""),
            "tvg_id": "",
        })
    return rows


EPISODE_CODE_RE = re.compile(r"\bS\d{1,2}\s?E\d{1,3}\b", re.IGNORECASE)


def episode_rows(info, series_id, host, q_user, q_pw, series_name=""):
    """Flatten get_series_info into ordered episode rows. Episodes arrive as
    {"1": [...], "2": [...]} keyed by season, or (some panels) as a list."""
    eps = (info or {}).get("episodes") or {}
    if isinstance(eps, list):
        eps = {str(i + 1): season for i, season in enumerate(eps)}
    name = series_name or ((info or {}).get("info") or {}).get("name") or ""
    rows = []
    for season_key, season in eps.items():
        for e in season or []:
            eid = e.get("id")
            if eid is None:
                continue
            try:
                snum = int(e.get("season") or season_key)
            except (TypeError, ValueError):
                snum = 0
            try:
                enum = int(e.get("episode_num") or 0)
            except (TypeError, ValueError):
                enum = 0
            title = e.get("title") or f"Episode {enum}"
            ext = e.get("container_extension") or "mp4"
            # Many panels already put "S01E02" in the title; don't say it twice.
            label = title if EPISODE_CODE_RE.search(title) else f"S{snum:02d}E{enum:02d} · {title}"
            rows.append({
                "id": f"xce-{series_id}-{eid}",
                "name": label,
                "season": snum,
                "episode": enum,
                "title": title,
                "group": f"Season {snum}",
                "series_name": name,
                "duration": str((e.get("info") or {}).get("duration") or ""),
                "url": f"{host}/series/{q_user}/{q_pw}/{eid}.{ext}",
                "tvg_id": "",
            })
    rows.sort(key=lambda r: (r["season"], r["episode"]))
    return rows


def sync_xtream(prov):
    host, api, q_user, q_pw, ua = xtream_api(prov)

    def cats(action):
        return {str(c.get("category_id")): c.get("category_name") or "Ungrouped"
                for c in fetch_json(f"{api}&action={action}", ua)}

    live_cats = cats("get_live_categories")
    vod_cats = cats("get_vod_categories")
    live = fetch_json(f"{api}&action=get_live_streams", ua)
    vod = fetch_json(f"{api}&action=get_vod_streams", ua)
    try:  # older panels have no series catalog; that is not a failed sync
        series = series_rows(fetch_json(f"{api}&action=get_series", ua),
                             cats("get_series_categories"))
    except (urllib.error.HTTPError, ValueError, ResponseTooLarge) as e:
        warn(f"warning: series catalog unavailable ({e}); continuing without series")
        series = []

    channels = [{
        "id": f"xc-{s.get('stream_id')}",
        "name": s.get("name") or f"ch {s.get('stream_id')}",
        "logo": s.get("stream_icon") or "",
        "group": live_cats.get(str(s.get("category_id")), "Ungrouped"),
        "url": f"{host}/live/{q_user}/{q_pw}/{s.get('stream_id')}.m3u8",
        "tvg_id": s.get("epg_channel_id") or "",
    } for s in live]
    items = [{
        "id": f"xcv-{s.get('stream_id')}",
        "name": s.get("name") or f"vod {s.get('stream_id')}",
        "logo": s.get("stream_icon") or "",
        "group": vod_cats.get(str(s.get("category_id")), "Ungrouped"),
        "url": (f"{host}/movie/{q_user}/{q_pw}/{s.get('stream_id')}."
                f"{s.get('container_extension') or 'mp4'}"),
        "tvg_id": "",
    } for s in vod]
    save_json(CHANNELS_JSON, channels)
    save_json(VOD_JSON, items)
    save_json(SERIES_JSON, series)

    try:  # full EPG file first, per API docs
        kept = fetch_xmltv(f"{host}/xmltv.php?username={q_user}&password={q_pw}", ua)
    except Exception as e:
        warn(f"warning: xmltv.php failed ({e}); EPG will be sparse")
        kept = 0
    return len(channels), len(items), len(series), kept


def episodes_path(series_id):
    return os.path.join(SERIES_DIR, f"{int(series_id)}.json")


def fetch_episodes(series_id, force=False):
    """Episode rows for one show, from the per-show cache when fresh, else
    one get_series_info call. Rows keep stream urls (mode-600 file); dumps
    slim them like every other list."""
    path = episodes_path(series_id)
    if not force:
        try:
            if time.time() - os.stat(path).st_mtime < EPISODES_TTL:
                return load_json(path)
        except OSError:
            pass
    prov = load_provider()
    if not prov or prov.get("type") != "xtream":
        die("series need an xtream provider", 2)
    host, api, q_user, q_pw, ua = xtream_api(prov)
    name = ""
    for row in load_json(SERIES_JSON):
        if str(row.get("series_id")) == str(series_id):
            name = row.get("name") or ""
            break
    info = fetch_json(f"{api}&action=get_series_info&series_id={int(series_id)}", ua)
    rows = episode_rows(info, int(series_id), host, q_user, q_pw, name)
    os.makedirs(SERIES_DIR, exist_ok=True)
    save_json(path, rows)
    return rows


def save_json(path, obj):
    os.makedirs(CACHE, exist_ok=True)
    tmp = path + ".tmp"
    # Created 0600 from the start: no window where the file is world-readable.
    with os.fdopen(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
        json.dump(obj, f)
    os.replace(tmp, path)


def load_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        return []


# --- dumps (QML reads these) -------------------------------------------------

# Logos and stream URLs stay in the 0600 cache. Dumps for the shell omit
# both: urls carry Xtream passwords, and nothing in QML renders logos.
DUMP_DROP = ("logo", "url")


def slim(row):
    return {k: v for k, v in row.items() if k not in DUMP_DROP}


def row_matches(row, query, group):
    narrowed = bool(group) and group != "All"
    if narrowed and (row.get("group") or "Ungrouped") != group:
        return False
    if query:
        q = query.lower()
        if q in (row.get("name") or "").lower():
            return True
        # A category name is a search shortcut only while no group is picked;
        # inside a group every row would trivially match its own group name.
        return not narrowed and q in (row.get("group") or "Ungrouped").lower()
    return True


def group_names(rows):
    seen = {}
    out = ["All"]
    for c in rows or []:
        g = c.get("group") or "Ungrouped"
        if g not in seen:
            seen[g] = True
            out.append(g)
    return out


def dump_rows(path, query, group, limit, with_epg=False):
    rows = load_json(path)
    now, by_ch = (epg_window() if with_epg else (0, {}))
    out = []
    for c in rows:
        if not row_matches(c, query, group):
            continue
        item = slim(c)
        if with_epg:
            cur, nxt = now_next(by_ch.get(c.get("tvg_id") or "", []), now)
            item["epg_now"] = cur
            item["epg_next"] = nxt
        out.append(item)
        if limit and len(out) >= limit:
            break
    json.dump(out, sys.stdout)


def dump_channels(query="", group="", limit=0):
    dump_rows(CHANNELS_JSON, query, group, limit, with_epg=True)


def dump_vod(query="", group="", limit=0):
    if not query and group in ("", "All"):
        json.dump([], sys.stdout)
        return
    dump_rows(VOD_JSON, query, group, limit, with_epg=False)


SERIES_LIST_ALL_MAX = 2000


def dump_series(query="", group="", limit=0):
    """A small catalog lists unfiltered; a huge one (some providers carry
    tens of thousands of shows) needs a group or a query first, like VOD."""
    rows = load_json(SERIES_JSON)
    if not query and group in ("", "All") and len(rows) > SERIES_LIST_ALL_MAX:
        json.dump([], sys.stdout)
        return
    q = (query or "").lower()
    out = []
    for c in rows:
        if not (row_matches(c, query, group) or (q and q in (c.get("plot") or "").lower())):
            continue
        out.append(slim(c))
        if limit and len(out) >= limit:
            break
    json.dump(out, sys.stdout)


def dump_episodes(sid, force=False):
    sid = str(sid or "")
    if sid.startswith("xcs-"):
        sid = sid[4:]
    if not sid.isdigit():
        die("dump-episodes needs --id xcs-<series_id>", 2)
    try:
        rows = fetch_episodes(sid, force)
    except urllib.error.HTTPError as e:
        die(f"provider returned HTTP {e.code} {e.reason}")
    except ResponseTooLarge as e:
        die(f"provider response too large: {e}")
    except (urllib.error.URLError, OSError, TimeoutError) as e:
        die(f"network error: {getattr(e, 'reason', e)}")
    except ValueError as e:
        die(f"bad provider response: {e}")
    json.dump([slim(r) for r in rows], sys.stdout)


def dump_groups(kind):
    path = {"vod": VOD_JSON, "series": SERIES_JSON}.get(kind, CHANNELS_JSON)
    json.dump(group_names(load_json(path)), sys.stdout)


def dump_ids(ids_csv):
    want = {s for s in (ids_csv or "").split(",") if s}
    if not want:
        json.dump([], sys.stdout)
        return
    now, by_ch = epg_window()
    out = []
    for path, with_epg in ((CHANNELS_JSON, True), (VOD_JSON, False), (SERIES_JSON, False)):
        for c in load_json(path):
            if str(c.get("id")) not in want:
                continue
            item = slim(c)
            if with_epg:
                cur, nxt = now_next(by_ch.get(c.get("tvg_id") or "", []), now)
                item["epg_now"] = cur
                item["epg_next"] = nxt
            out.append(item)
    json.dump(out, sys.stdout)


def play_url(sid):
    sid = str(sid or "")
    if not sid:
        die("play-url needs --id", 2)
    m = re.match(r"xce-(\d+)-(\d+)$", sid)
    if m:  # episode: resolve from the show's cache, refetching if it aged out
        for row in fetch_episodes(m.group(1)):
            if str(row.get("id")) == sid and row.get("url"):
                sys.stdout.write(row["url"])
                return
        die("unknown episode id", 2)
    for path in (CHANNELS_JSON, VOD_JSON):
        for row in load_json(path):
            if str(row.get("id")) == sid and row.get("url"):
                sys.stdout.write(row["url"])
                return
    die("unknown stream id", 2)


def dump_status():
    """Cache freshness for the shell: drives auto re-sync and the Setup tab."""
    prov = None
    try:
        prov = load_provider()
    except SystemExit:
        pass
    try:
        synced_at = int(os.stat(CHANNELS_JSON).st_mtime)
    except OSError:
        synced_at = 0
    epg_count = epg_until = 0
    if os.path.exists(EPG_DB):
        try:
            db = sqlite3.connect(f"file:{EPG_DB}?mode=ro", uri=True)
            try:
                epg_count, epg_until = db.execute(
                    "SELECT COUNT(*), COALESCE(MAX(end), 0) FROM programmes").fetchone()
            finally:
                db.close()
        except sqlite3.Error:
            pass
    p = prov or {}
    t = p.get("type") or ""
    has_pw = False
    if t == "xtream" and p.get("username"):
        try:
            has_pw = bool(get_password(p))
        except SystemExit:
            has_pw = False
    json.dump({
        "provider": t,
        "host": p.get("host") or "",
        "username": p.get("username") or "",
        "url": p.get("url") or "",
        "epg": p.get("epg") or "",
        "user_agent": p.get("user_agent") or "",
        "has_password": has_pw,
        "has_epg": bool(t == "xtream" or p.get("epg")),
        "synced_at": synced_at,
        "channels": len(load_json(CHANNELS_JSON)),
        "vod": len(load_json(VOD_JSON)),
        "series": len(load_json(SERIES_JSON)),
        "epg_programmes": epg_count,
        "epg_until": epg_until,
    }, sys.stdout)


def dump_epg_now():
    """Now/next for every channel that has guide data, keyed by channel id.
    Cheap enough for the shell to re-run every few minutes."""
    channels = load_json(CHANNELS_JSON)
    now, by_ch = epg_window()
    out = []
    for c in channels:
        progs = by_ch.get(c.get("tvg_id") or "")
        if not progs:
            continue
        cur, nxt = now_next(progs, now)
        if cur or nxt:
            out.append({"channel_id": c.get("id"), "name": c.get("name"),
                        "now": cur, "next": nxt})
    json.dump(out, sys.stdout)


def main():
    ap = argparse.ArgumentParser()
    g = ap.add_mutually_exclusive_group(required=True)
    g.add_argument("--sync", action="store_true")
    g.add_argument("--dump-channels", action="store_true")
    g.add_argument("--dump-vod", action="store_true")
    g.add_argument("--dump-series", action="store_true")
    g.add_argument("--dump-episodes", action="store_true")
    g.add_argument("--dump-epg-now", action="store_true")
    g.add_argument("--dump-status", action="store_true")
    g.add_argument("--dump-groups", choices=["live", "vod", "series"])
    g.add_argument("--dump-ids", metavar="IDS")
    g.add_argument("--play-url", action="store_true")
    g.add_argument("--write-provider", action="store_true")
    ap.add_argument("--group", default="")
    ap.add_argument("--query", default="")
    ap.add_argument("--limit", type=int, default=0)
    ap.add_argument("--id", default="")
    ap.add_argument("--refresh", action="store_true", help="with --dump-episodes: bypass the cache")
    ap.add_argument("--type", dest="prov_type", default="")
    ap.add_argument("--host", default="")
    ap.add_argument("--username", default="")
    ap.add_argument("--url", default="")
    ap.add_argument("--epg", default="")
    ap.add_argument("--user-agent", default="")
    a = ap.parse_args()

    # So the shell's favorites.json write never fails on a fresh install.
    os.makedirs(CONFIG_DIR, exist_ok=True)

    if a.dump_channels:
        dump_channels(a.query, a.group, a.limit)
    elif a.dump_vod:
        dump_vod(a.query, a.group, a.limit)
    elif a.dump_series:
        dump_series(a.query, a.group, a.limit)
    elif a.dump_episodes:
        dump_episodes(a.id, a.refresh)
    elif a.dump_epg_now:
        dump_epg_now()
    elif a.dump_status:
        dump_status()
    elif a.dump_groups:
        dump_groups(a.dump_groups)
    elif a.dump_ids is not None:
        dump_ids(a.dump_ids)
    elif a.play_url:
        play_url(a.id)
    elif a.write_provider:
        write_provider(a)
    else:
        prov = load_provider()
        if not prov:
            die(f"no provider: create {CONFIG} (see README)")
        t = prov.get("type")
        try:
            if t == "m3u":
                nc, nv, ns, ne = sync_m3u(prov)
            elif t == "xtream":
                nc, nv, ns, ne = sync_xtream(prov)
            else:
                die("provider type must be 'm3u' or 'xtream'")
        except KeyError as e:
            die(f"provider.json missing key {e}")
        except urllib.error.HTTPError as e:
            die(f"provider returned HTTP {e.code} {e.reason}")
        except ResponseTooLarge as e:
            die(f"provider response too large: {e}")
        except (urllib.error.URLError, OSError, TimeoutError) as e:
            die(f"network error: {getattr(e, 'reason', e)}")
        except (ValueError, ET.ParseError) as e:
            die(f"bad provider response: {e}")
        print(f"synced: {nc} live, {nv} vod, {ns} series, {ne} epg programmes")


if __name__ == "__main__":
    main()
