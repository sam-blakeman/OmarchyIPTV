#!/usr/bin/env python3
"""Single-provider IPTV sync for the Omarchy IPTV plugin (stdlib only).

Reads  ~/.config/omarchy-iptv/provider.json  (one provider):

  m3u:    {"type": "m3u", "url": "https://.../playlist.m3u",
           "epg": "https://.../xmltv.xml"}            # epg optional
  xtream: {"type": "xtream", "host": "http://host:8080",
           "username": "user"}                        # password via
           # secret-tool / $IPTV_PASSWORD / "password" key (last resort)

  Optional for both: "user_agent": "..."  (some providers whitelist UAs)

Cache lives in ~/.cache/omarchy-iptv/: channels.json, vod.json, epg.db.
Only now-2h..now+24h of EPG is kept, so the shell never holds a week
of listings in memory.

NOTE: stream URLs for Xtream embed the password (required by the
protocol). They are written to mode-600 cache files and emitted on
--dump-* for the QML player only. Error output is passed through
redact() so a password can never reach the shell log.
"""

import argparse
import gzip
import hashlib
import io
import json
import os
import re
import sqlite3
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime, timedelta, timezone
from xml.etree import ElementTree as ET

CONFIG_DIR = os.path.expanduser("~/.config/omarchy-iptv")
CONFIG = os.path.join(CONFIG_DIR, "provider.json")
CACHE = os.path.expanduser("~/.cache/omarchy-iptv")
CHANNELS_JSON = os.path.join(CACHE, "channels.json")
VOD_JSON = os.path.join(CACHE, "vod.json")
EPG_DB = os.path.join(CACHE, "epg.db")
TIMEOUT = 60
DEFAULT_UA = "omarchy-iptv/0.1"

# Strings that must never appear in stderr (filled in by sync_xtream).
SECRETS = []


def redact(text):
    text = str(text)
    for s in SECRETS:
        if s:
            text = text.replace(s, "***")
            text = text.replace(urllib.parse.quote(s, safe=""), "***")
    return text


def warn(msg):
    print(redact(msg), file=sys.stderr)


def die(msg, code=1):
    warn(msg)
    sys.exit(code)


# --- config / secrets -------------------------------------------------------

def load_provider():
    try:
        with open(CONFIG) as f:
            return json.load(f)
    except FileNotFoundError:
        return None
    except json.JSONDecodeError as e:
        die(f"bad {CONFIG}: {e}")


def get_password(prov):
    username = prov["username"]
    if os.environ.get("IPTV_PASSWORD"):
        return os.environ["IPTV_PASSWORD"]
    try:
        p = subprocess.run(
            ["secret-tool", "lookup", "application", "user.iptv",
             "username", username],
            capture_output=True, text=True, timeout=10)
        if p.returncode == 0 and p.stdout.strip():
            return p.stdout.strip()
    except (FileNotFoundError, subprocess.TimeoutExpired):
        pass
    if prov.get("password"):
        mode = os.stat(CONFIG).st_mode & 0o777
        if mode & 0o077:
            warn(f"warning: {CONFIG} holds a password but is mode {mode:o}; "
                 "chmod 600 it")
        return prov["password"]
    return None


# --- http -------------------------------------------------------------------

def fetch(url, user_agent=None):
    req = urllib.request.Request(
        url, headers={"User-Agent": user_agent or DEFAULT_UA,
                      "Accept-Encoding": "gzip"})
    with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
        data = r.read()
    if r.headers.get("Content-Encoding") == "gzip" or data[:2] == b"\x1f\x8b":
        data = gzip.decompress(data)
    return data


def fetch_json(url, user_agent=None):
    return json.loads(fetch(url, user_agent).decode("utf-8", "replace"))


# --- m3u --------------------------------------------------------------------

ATTR_RE = re.compile(r'([\w.-]+)="([^"]*)"')


def split_extinf(line):
    """Return (attrs_text, name) for an #EXTINF line.

    The name starts after the first comma that is outside double quotes,
    so `group-title="UK, News",BBC One` and `#EXTINF:0,Name, With Comma`
    both come out right.
    """
    in_quote = False
    for i, ch in enumerate(line):
        if ch == '"':
            in_quote = not in_quote
        elif ch == "," and not in_quote:
            return line[:i], line[i + 1:].strip()
    return line, ""


def stable_id(url, name, group):
    # Same row => same id across re-syncs regardless of playlist order, so
    # favorites survive; two streams sharing one tvg-id (HD/SD variants) or
    # one URL listed under two groups stay distinct.
    key = f"{url}\n{name}\n{group}".encode("utf-8", "replace")
    return "m3u-" + hashlib.sha1(key).hexdigest()[:12]


def parse_m3u(text):
    channels = []
    current = None
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        if line.upper().startswith("#EXTINF"):
            head, name = split_extinf(line)
            attrs = dict(ATTR_RE.findall(head))
            current = {
                "tvg_id": attrs.get("tvg-id", ""),
                "logo": attrs.get("tvg-logo", ""),
                "group": attrs.get("group-title") or "Ungrouped",
                "name": name or attrs.get("tvg-name") or "Unknown",
            }
        elif line.startswith("#"):
            continue  # #EXTVLCOPT, #KODIPROP, #EXTGRP, ...
        elif current is not None:
            current["url"] = line
            current["id"] = stable_id(line, current["name"], current["group"])
            channels.append(current)
            current = None
    return channels


# --- xmltv ------------------------------------------------------------------

XMLTV_TIME_RE = re.compile(r"(\d{14})(?:\s+([+-])(\d{2})(\d{2}))?")


def parse_xmltv_time(s):
    # "20260907120000 +0200" (offset optional, defaults to UTC)
    m = XMLTV_TIME_RE.match((s or "").strip())
    if not m:
        return None
    dt = datetime.strptime(m.group(1), "%Y%m%d%H%M%S")
    tz = timezone.utc
    if m.group(2):
        minutes = int(m.group(3)) * 60 + int(m.group(4))
        tz = timezone(timedelta(minutes=-minutes if m.group(2) == "-" else minutes))
    return int(dt.replace(tzinfo=tz).timestamp())


def epg_db():
    os.makedirs(CACHE, exist_ok=True)
    db = sqlite3.connect(EPG_DB)
    os.chmod(EPG_DB, 0o600)
    db.execute("""CREATE TABLE IF NOT EXISTS programmes
                  (channel TEXT, start INTEGER, end INTEGER,
                   title TEXT, desc TEXT)""")
    db.execute("CREATE INDEX IF NOT EXISTS idx_prog ON programmes(channel, start, end)")
    db.execute("""CREATE TABLE IF NOT EXISTS channels
                  (id TEXT PRIMARY KEY, name TEXT)""")
    return db


def _text(elem, tag):
    child = elem.find(tag)
    return child.text.strip() if child is not None and child.text else ""


def import_xmltv(xml_bytes):
    """Stream-parse XMLTV so a week-long, multi-MB guide never sits in
    memory as a DOM; only the now-2h..now+24h rows are kept."""
    now = int(time.time())
    keep_from, keep_to = now - 2 * 3600, now + 24 * 3600
    names = {}
    rows = []
    for _event, el in ET.iterparse(io.BytesIO(xml_bytes), events=("end",)):
        if el.tag == "channel":
            cid = el.get("id", "")
            dn = _text(el, "display-name")
            if cid and dn:
                names[cid] = dn
            el.clear()
        elif el.tag == "programme":
            start = parse_xmltv_time(el.get("start"))
            end = parse_xmltv_time(el.get("stop"))
            if start and end and end >= keep_from and start <= keep_to:
                rows.append((el.get("channel", ""), start, end,
                             _text(el, "title"), _text(el, "desc")[:500]))
            el.clear()
    db = epg_db()
    with db:
        db.execute("DELETE FROM programmes")
        db.executemany("INSERT INTO programmes VALUES (?,?,?,?,?)", rows)
        db.execute("DELETE FROM channels")
        db.executemany("INSERT OR REPLACE INTO channels VALUES (?,?)", list(names.items()))
    db.close()
    return len(rows)


def epg_window():
    """All programmes overlapping now..now+6h, keyed by channel."""
    now = int(time.time())
    if not os.path.exists(EPG_DB):  # never create an empty db from a dump
        return now, {}
    try:
        db = sqlite3.connect(f"file:{EPG_DB}?mode=ro", uri=True)
        try:
            rows = db.execute(
                "SELECT channel, start, end, title FROM programmes "
                "WHERE end > ? AND start < ? ORDER BY start",
                (now, now + 6 * 3600)).fetchall()
        finally:
            db.close()
    except sqlite3.Error:
        return now, {}
    by_ch = {}
    for cid, s, e, t in rows:
        by_ch.setdefault(cid, []).append({"start": s, "end": e, "title": t or ""})
    return now, by_ch


def now_next(progs, now):
    cur = nxt = ""
    for p in progs:
        if p["start"] <= now < p["end"]:
            cur = p["title"]
        elif p["start"] > now and not nxt:
            nxt = p["title"]
    return cur, nxt


# --- sync -------------------------------------------------------------------

def sync_m3u(prov):
    ua = prov.get("user_agent")
    channels = parse_m3u(fetch(prov["url"], ua).decode("utf-8", "replace"))
    if not channels:
        die("playlist fetched but no channels parsed; is the url an m3u?")
    save_json(CHANNELS_JSON, channels)
    save_json(VOD_JSON, [])  # m3u has no VOD split in v1
    kept = 0
    if prov.get("epg"):
        try:
            kept = import_xmltv(fetch(prov["epg"], ua))
        except Exception as e:
            warn(f"warning: EPG fetch failed ({e}); continuing without EPG")
    return len(channels), 0, kept


def sync_xtream(prov):
    host = prov["host"].rstrip("/")
    user = prov["username"]
    ua = prov.get("user_agent")
    pw = get_password(prov)
    if not pw:
        die("xtream password missing: secret-tool store --label omarchy-iptv "
            f"application user.iptv username {user}  (or $IPTV_PASSWORD)")
    SECRETS.append(pw)
    q_user, q_pw = urllib.parse.quote(user, safe=""), urllib.parse.quote(pw, safe="")
    api = f"{host}/player_api.php?username={q_user}&password={q_pw}"

    def cats(action):
        return {str(c.get("category_id")): c.get("category_name") or "Ungrouped"
                for c in fetch_json(f"{api}&action={action}", ua)}

    live_cats = cats("get_live_categories")
    vod_cats = cats("get_vod_categories")
    live = fetch_json(f"{api}&action=get_live_streams", ua)
    vod = fetch_json(f"{api}&action=get_vod_streams", ua)

    channels = [{
        "id": f"xc-{s.get('stream_id')}",
        "name": s.get("name") or f"ch {s.get('stream_id')}",
        "logo": s.get("stream_icon") or "",
        "group": live_cats.get(str(s.get("category_id")), "Ungrouped"),
        "url": f"{host}/live/{q_user}/{q_pw}/{s.get('stream_id')}.m3u8",
        "tvg_id": s.get("epg_channel_id") or "",
    } for s in live]
    items = [{
        "id": f"xcv-{s.get('stream_id')}",
        "name": s.get("name") or f"vod {s.get('stream_id')}",
        "logo": s.get("stream_icon") or "",
        "group": vod_cats.get(str(s.get("category_id")), "Ungrouped"),
        "url": (f"{host}/movie/{q_user}/{q_pw}/{s.get('stream_id')}."
                f"{s.get('container_extension') or 'mp4'}"),
        "tvg_id": "",
    } for s in vod]
    save_json(CHANNELS_JSON, channels)
    save_json(VOD_JSON, items)

    try:  # full EPG file first, per API docs
        kept = import_xmltv(fetch(f"{host}/xmltv.php?username={q_user}&password={q_pw}", ua))
    except Exception as e:
        warn(f"warning: xmltv.php failed ({e}); EPG will be sparse")
        kept = 0
    return len(channels), len(items), kept


def save_json(path, obj):
    os.makedirs(CACHE, exist_ok=True)
    tmp = path + ".tmp"
    # Created 0600 from the start: no window where the file is world-readable.
    with os.fdopen(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
        json.dump(obj, f)
    os.replace(tmp, path)


def load_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        return []


# --- dumps (QML reads these) -------------------------------------------------

def dump_channels():
    channels = load_json(CHANNELS_JSON)
    now, by_ch = epg_window()
    out = []
    for c in channels:
        cur, nxt = now_next(by_ch.get(c.get("tvg_id") or "", []), now)
        out.append({**c, "epg_now": cur, "epg_next": nxt})
    json.dump(out, sys.stdout)


def dump_vod():
    json.dump(load_json(VOD_JSON), sys.stdout)


def dump_epg_now():
    """Now/next for every channel that has guide data, keyed by channel id.
    Cheap enough for the shell to re-run every few minutes."""
    channels = load_json(CHANNELS_JSON)
    now, by_ch = epg_window()
    out = []
    for c in channels:
        progs = by_ch.get(c.get("tvg_id") or "")
        if not progs:
            continue
        cur, nxt = now_next(progs, now)
        if cur or nxt:
            out.append({"channel_id": c.get("id"), "name": c.get("name"),
                        "now": cur, "next": nxt})
    json.dump(out, sys.stdout)


def main():
    ap = argparse.ArgumentParser()
    g = ap.add_mutually_exclusive_group(required=True)
    g.add_argument("--sync", action="store_true")
    g.add_argument("--dump-channels", action="store_true")
    g.add_argument("--dump-vod", action="store_true")
    g.add_argument("--dump-epg-now", action="store_true")
    a = ap.parse_args()

    # So the shell's favorites.json write never fails on a fresh install.
    os.makedirs(CONFIG_DIR, exist_ok=True)

    if a.dump_channels:
        dump_channels()
    elif a.dump_vod:
        dump_vod()
    elif a.dump_epg_now:
        dump_epg_now()
    else:
        prov = load_provider()
        if not prov:
            die(f"no provider: create {CONFIG} (see README)")
        t = prov.get("type")
        try:
            if t == "m3u":
                nc, nv, ne = sync_m3u(prov)
            elif t == "xtream":
                nc, nv, ne = sync_xtream(prov)
            else:
                die("provider type must be 'm3u' or 'xtream'")
        except KeyError as e:
            die(f"provider.json missing key {e}")
        except urllib.error.HTTPError as e:
            die(f"provider returned HTTP {e.code} {e.reason}")
        except (urllib.error.URLError, OSError, TimeoutError) as e:
            die(f"network error: {getattr(e, 'reason', e)}")
        except (ValueError, ET.ParseError) as e:
            die(f"bad provider response: {e}")
        print(f"synced: {nc} live, {nv} vod, {ne} epg programmes")


if __name__ == "__main__":
    main()
