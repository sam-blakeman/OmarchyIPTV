#!/bin/bash
# Play an IPTV stream in external mpv. Keeps decoding out of omarchy-shell
# so a bad stream can never take the bar down with it.
#
# Usage: iptv-play <url> [--title <name>]
# Stopping = killing this process (QML sets playProc.running = false).

set -u

URL="${1:-}"
TITLE="IPTV"
if [[ "${2:-}" == "--title" ]]; then
  TITLE="${3:-IPTV}"
fi

if [[ -z $URL ]]; then
  echo "usage: iptv-play <url> [--title <name>]" >&2
  exit 2
fi

if ! command -v mpv >/dev/null 2>&1; then
  echo "iptv-play: mpv not found (omarchy pkg add mpv)" >&2
  exit 127
fi

# Providers that whitelist a User-Agent need mpv to send the same one the
# sync used. Optional "user_agent" key in provider.json.
EXTRA=()
CONF="$HOME/.config/omarchy-iptv/provider.json"
if [[ -r $CONF ]]; then
  UA=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("user_agent") or "")' "$CONF" 2>/dev/null)
  [[ -n $UA ]] && EXTRA+=(--user-agent="$UA")
fi

# --force-media-title keeps the URL (which carries the password for Xtream)
# out of mpv's OSD and title; --ytdl=no skips the yt-dlp probe on every
# stream URL.
exec mpv --title="omarchy-iptv: $TITLE" --force-media-title="$TITLE" \
  --force-window=yes --keep-open=no --ytdl=no "${EXTRA[@]}" "$URL"
