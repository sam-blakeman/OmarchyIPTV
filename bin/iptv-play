#!/bin/bash
# Play an IPTV stream in external mpv. Keeps decoding out of omarchy-shell
# so a bad stream can never take the bar down with it.
#
# Usage: iptv-play --id <id> [--title <name>]
#        iptv-play <url> [--title <name>]
# Stopping = killing this process (QML sets playProc.running = false).

set -u

ID=""
URL=""
TITLE="IPTV"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --id)
      ID="${2:-}"
      shift 2
      ;;
    --title)
      TITLE="${2:-IPTV}"
      shift 2
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "usage: iptv-play --id <id> [--title <name>]" >&2
      exit 2
      ;;
    *)
      URL="$1"
      shift
      ;;
  esac
done

SYNC="$(dirname "$0")/iptv-sync"

if [[ -n $ID ]]; then
  URL=$("$SYNC" --play-url --id "$ID") || exit $?
fi

if [[ -z $URL ]]; then
  echo "usage: iptv-play --id <id> [--title <name>]" >&2
  exit 2
fi

if ! command -v mpv >/dev/null 2>&1; then
  echo "iptv-play: mpv not found (omarchy pkg add mpv)" >&2
  exit 127
fi

EXTRA=()
CONF="$HOME/.config/omarchy-iptv/provider.json"
if [[ -r $CONF ]]; then
  UA=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("user_agent") or "")' "$CONF" 2>/dev/null)
  [[ -n $UA ]] && EXTRA+=(--user-agent="$UA")
fi

exec mpv --title="omarchy-iptv: $TITLE" --force-media-title="$TITLE" \
  --force-window=yes --keep-open=no --ytdl=no --msg-level=all=error \
  "${EXTRA[@]}" "$URL"
